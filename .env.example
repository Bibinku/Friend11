# Copy to .env.local (dev) and set the same variables in your host's
# environment settings (production). Never put a secret/service-role key here.

# Supabase → Settings → API. The publishable (formerly "anon") key is safe
# in client code; Row Level Security protects the data.
VITE_SUPABASE_URL=https://zgsznbfxszqnsaqpyhug.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_cSOge0cZX1cNIfBjdMSQFQ_3878oJw0

# The public origin of the DEPLOYED site — used for Google and email
# sign-in redirects. No trailing slash. Set this in production, e.g.
#   VITE_SITE_URL=https://friend11.example.com
# Leave empty locally: `npm run dev` always redirects back to whatever
# origin you're browsing (localhost, or your LAN address).
VITE_SITE_URL=

# Optional. Google Apps Script web-app URL that appends a row
# (Username | Email | Login Time) on each sign-in. Leave empty to disable.
VITE_GOOGLE_SHEET_API_URL=
